{
  "name": "mymusicplayer",
  "version": "1.0.0",
  "description": "Complete standalone offline music player for macOS M1",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "unset ELECTRON_RUN_AS_NODE && concurrently \"npm run dev\" \"wait-on http://localhost:5174 && env -u ELECTRON_RUN_AS_NODE npx electron .\"",
    "electron:build": "npm run build && electron-builder",
    "electron:build:arm64": "npm run build && electron-builder --mac --arm64",
    "electron:build:universal": "npm run build && electron-builder --mac --universal",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.1",
    "better-sqlite3": "^11.3.0",
    "lucide-react": "^0.379.0",
    "music-metadata": "^12.3.4",
    "node-id3": "^0.2.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.5.0",
    "react-router-dom": "^6.26.0",
    "react-virtualized": "^10.0.0",
    "recharts": "^2.12.0",
    "uuid": "^14.0.3",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "electron": "^31.2.0",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.0",
    "vite": "^5.4.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.mymusicplayer.app",
    "productName": "MyMusicPlayer",
    "copyright": "Copyright © 2024 MyMusicPlayer. All rights reserved.",
    "directories": {
      "output": "dist-electron",
      "buildResources": "build-resources"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.music",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "darkModeSupport": true
    },
    "dmg": {
      "title": "MyMusicPlayer Installer",
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 180,
          "y": 170,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 360,
          "y": 170,
          "type": "file"
        }
      ]
    },
    "asar": true,
    "compression": "maximum",
    "npmRebuild": false,
    "nodeGypRebuild": false
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
